---
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import Styles from "./styles.module.scss";
import { site } from "../../data/site";

// Normalize trailing slashes so "/services" and "/services/" both match
const normalize = (path: string) =>
  path.length > 1 && path.endsWith("/") ? path.slice(0, -1) : path;
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) => currentPath === normalize(href);
---

<header class="p-2 text-white">
  <div
    class="container flex flex-col lg:flex-row lg:items-center lg:justify-between lg:text-lg lg:px-4 tracking-wider font-semibold drop-shadow-md" style="max-width: 100%"
  >
    <Astronav closeOnClick>
      <div class="flex justify-between items-center w-full lg:w-auto">
        <a href="/" class={Styles.brand}>{site.name}</a>
        <div class="block lg:hidden">
          <MenuIcon class="w-6 h-6 m-2 text-white" />
        </div>
      </div>
      <MenuItems class="hidden lg:flex pt-2.5">
        <ul class="flex flex-col lg:flex-row lg:gap-5 lg:items-center">
          <li class={Styles.navItem}>
            <a href="/" class={isActive("/") ? Styles.active : ""}>Home</a>
          </li>
          <li class={Styles.navItem}>
            <a href="/services/" class={isActive("/services/") ? Styles.active : ""}>Services</a>
          </li>
          <li class={Styles.navItem}>
            <a href="/portfolio/" class={isActive("/portfolio/") || currentPath.startsWith("/portfolio/") ? Styles.active : ""}>Portfolio</a>
          </li>
          <li class={Styles.navItem}>
            <a href="/research/" class={isActive("/research/") ? Styles.active : ""}>Research</a>
          </li>
          <li class={Styles.navItem}>
            <a href="/contact/" class={isActive("/contact/") ? Styles.active : ""}>Contact</a>
          </li>
        </ul>
      </MenuItems>
    </Astronav>
  </div>
</header>
